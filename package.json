{
  "name": "tech-challenge-api",
  "version": "2.3.0",
  "description": "Back-end do Tech Challenge FIAP: sistema de atendimento e execução de serviços de uma oficina mecânica",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "prisma generate",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src/ test/ prisma/",
    "lint": "biome lint src/ test/ prisma/",
    "check": "biome check --write src/ test/ prisma/",
    "ci": "biome ci src/ test/ prisma/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:integration": "bun test --path-ignore-patterns='node_modules/**' ./test/integration",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version": "changeset version",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "prisma:validate": "prisma validate"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma"
  ],
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.2"
  }
}
