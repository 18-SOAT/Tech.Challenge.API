# Banco — usado ao rodar a API fora do Docker (`bun run dev`).
# No docker compose o DATABASE_URL é montado a partir das POSTGRES_* abaixo, com host `postgres`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechanic_system"

# Postgres do docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mechanic_system
POSTGRES_PORT=5432 # porta exposta no host; troque se já tiver um Postgres local na 5432

# JWT — gere um segredo forte, ex: `openssl rand -base64 32` (obrigatório; o compose não sobe sem)
JWT_SECRET=""
JWT_EXPIRES_IN="" # exemplo de valores: 1h / 1d / 1w / 1m / 1y

# Porta HTTP da API
PORT=3000

# Seed (`bun run db:seed`, roda sozinho no docker compose) — ADMIN de demonstração.
# Vazio = padrão admin@oficina.com / admin12345. Senha: mínimo 8 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
