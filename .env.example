# Banco — usado ao rodar a API fora do Docker (`bun run dev`).
# No docker compose o DATABASE_URL é montado a partir das POSTGRES_* abaixo, com host `postgres`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechanic_system"

# Postgres do docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mechanic_system
POSTGRES_PORT=5432 # porta exposta no host; troque se já tiver um Postgres local na 5432

# JWT — gere um segredo forte, ex: `openssl rand -base64 32` (obrigatório; o compose não sobe sem)
JWT_SECRET=""
JWT_EXPIRES_IN="" # exemplo de valores: 1h / 1d / 1w / 1m / 1y

# Link de acesso (primeiro acesso / redefinição de senha), enviado por e-mail.
# Vazio = 15m. Mantenha curto: o link trafega por e-mail.
ACCESS_LINK_EXPIRES_IN=""
# Base pública da API, usada para montar o link no e-mail. Vazio = http://localhost:3000
APP_URL=""

# E-mail — SMTP.
# Padrão (tudo vazio): Mailpit, que captura sem entregar — caixa de entrada em
# http://localhost:8025. No compose a API usa host `mailpit`; fora do Docker,
# suba só ele com `docker compose up mailpit` (a API usa localhost:1025).
# Envio real pelo Gmail: verificação em duas etapas ligada + senha de app
# (Conta Google → Segurança → Senhas de app), e então:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT=465
#   SMTP_USER="<conta>@gmail.com"  SMTP_PASS="<senha de app>"
#   MAIL_FROM="Oficina <<conta>@gmail.com>"  (o Gmail força o remetente da conta)
# NUNCA versione a senha: ela só existe no seu .env (ignorado pelo git).
SMTP_HOST="" # vazio = localhost (fora do Docker) / mailpit (no compose)
SMTP_PORT="" # vazio = 1025
SMTP_USER="" # vazio = sem login (Mailpit)
SMTP_PASS=""
MAIL_FROM="" # vazio = Oficina <nao-responda@oficina.local>

# Porta HTTP da API
PORT=3000

# Seed (`bun run db:seed`, roda sozinho no docker compose) — ADMIN de demonstração.
# Vazio = padrão admin@oficina.com / admin12345. Senha: mínimo 8 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
