<mxfile host="65bd71144e">
    <diagram name="Subdomínios" id="p0">
        <mxGraphModel dx="13200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" background="#FAFAF7" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" value="Subdomínios — Manutenção e reparo de veículos" vertex="1">
                    <mxGeometry height="36" width="1420" x="40" y="24" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#5F6B7A;" value="Classificação estratégica: onde está o diferencial da oficina e onde basta uma solução simples ou pronta" vertex="1">
                    <mxGeometry height="24" width="1420" x="40" y="62" as="geometry"/>
                </mxCell>
                <mxCell id="c3" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontFamily=Helvetica;fontColor=#1F2933;" value="CORE — o diferencial do negócio" vertex="1">
                    <mxGeometry height="175" width="1420" x="40" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FFB74D;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Gestão de Ordens de Serviço&lt;/b&gt;&lt;br&gt;Diagnóstico, orçamento, aprovação pelo cliente, execução e acompanhamento de status em tempo real.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; resolve as dores centrais da oficina e tem a lógica mais rica (transições de status, orçamento congelado, aprovação atômica com baixa de estoque).&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; Atendimento · módulo &lt;i&gt;service-order&lt;/i&gt;" vertex="1">
                    <mxGeometry height="105" width="1360" x="70" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="c5" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontFamily=Helvetica;fontColor=#1F2933;" value="SUPORTE — necessário, mas não diferencia" vertex="1">
                    <mxGeometry height="225" width="1420" x="40" y="305" as="geometry"/>
                </mxCell>
                <mxCell id="c6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Catálogo e Estoque&lt;/b&gt;&lt;br&gt;Serviços, peças e insumos, saldo e movimentações.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; necessário para o orçamento; regras simples (saldo ≥ 0, mínimo).&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; Catálogo e Estoque · &lt;i&gt;inventory&lt;/i&gt;" vertex="1">
                    <mxGeometry height="155" width="430" x="70" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="c7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Clientes e Veículos&lt;/b&gt;&lt;br&gt;Cadastro com validação de CPF/CNPJ e placa.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; essencialmente CRUD com validação; sem vantagem competitiva.&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; Clientes e Veículos · &lt;i&gt;customer, vehicle&lt;/i&gt;" vertex="1">
                    <mxGeometry height="155" width="430" x="530" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="c8" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Indicadores operacionais&lt;/b&gt;&lt;br&gt;Tempo médio de execução dos serviços.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; cálculo derivado do histórico da OS, sem regra própria.&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; dentro de Atendimento (read model)" vertex="1">
                    <mxGeometry height="155" width="430" x="990" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="c9" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#BA68C8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontFamily=Helvetica;fontColor=#1F2933;" value="GENÉRICO — comum a qualquer empresa, pode ser comprado" vertex="1">
                    <mxGeometry height="225" width="1420" x="40" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="c10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CE93D8;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Identidade e Acesso&lt;/b&gt;&lt;br&gt;Login, senha (bcrypt) e JWT com papéis.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; todo sistema tem; usamos bibliotecas prontas (jose, bcrypt).&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; Identidade e Acesso · &lt;i&gt;user, auth, employee&lt;/i&gt;" vertex="1">
                    <mxGeometry height="155" width="430" x="70" y="595" as="geometry"/>
                </mxCell>
                <mxCell id="c11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CE93D8;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Notificações&lt;/b&gt;&lt;br&gt;Envio do link de acesso e do orçamento por e-mail.&lt;br&gt;&lt;b&gt;Por quê:&lt;/b&gt; commodity (serviço de e-mail).&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt; sem contexto próprio no MVP (port EmailSender usado por Identidade e Atendimento)" vertex="1">
                    <mxGeometry height="155" width="430" x="530" y="595" as="geometry"/>
                </mxCell>
                <mxCell id="c12" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#5F6B7A;" value="&lt;b&gt;Critério (fluxograma de Vlad Khononov):&lt;/b&gt; a solução pode ser comprada ou adotada pronta sem risco para o negócio? → Genérico. Não pode, e a lógica é complexa? → Core. Não pode, mas a lógica é simples? → Suporte." vertex="1">
                    <mxGeometry height="60" width="1420" x="40" y="790" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Context Map" id="p1">
        <mxGraphModel dx="1760" dy="1077" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" background="#FAFAF7" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" value="Context Map — bounded contexts e padrões de integração" vertex="1">
                    <mxGeometry height="36" width="1420" x="40" y="24" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#5F6B7A;" value="Monolito modular: cada contexto é um conjunto de módulos em src/modules; U = upstream, D = downstream" vertex="1">
                    <mxGeometry height="24" width="1420" x="40" y="62" as="geometry"/>
                </mxCell>
                <mxCell id="c3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Identidade e Acesso&lt;/b&gt;&lt;br&gt;&lt;i&gt;genérico · user, auth, employee&lt;/i&gt;&lt;br&gt;&lt;br&gt;User, Employee · Email, Password&lt;br&gt;Login e emissão de JWT (CustomerClaims | EmployeeClaims)&lt;br&gt;Primeiro acesso e redefinição de senha por e-mail&lt;br&gt;Papéis: ADMIN, MECHANIC" vertex="1">
                    <mxGeometry height="160" width="400" x="70" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Clientes e Veículos&lt;/b&gt;&lt;br&gt;&lt;i&gt;suporte · customer, vehicle&lt;/i&gt;&lt;br&gt;&lt;br&gt;Customer, Vehicle&lt;br&gt;Document (CPF/CNPJ), Phone, LicensePlate" vertex="1">
                    <mxGeometry height="130" width="400" x="70" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="c5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F06292;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Atendimento&lt;/b&gt;&lt;br&gt;&lt;i&gt;core · service-order&lt;/i&gt;&lt;br&gt;&lt;br&gt;Order (estadia), ServiceOrder (orçamento → execução)&lt;br&gt;ServiceItem, ProductItem, ServiceOrderStatusHistory&lt;br&gt;Transições de status, aprovação, entrega" vertex="1">
                    <mxGeometry height="170" width="420" x="590" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="c6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB74D;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Catálogo e Estoque&lt;/b&gt;&lt;br&gt;&lt;i&gt;suporte · inventory&lt;/i&gt;&lt;br&gt;&lt;br&gt;Service, Product&lt;br&gt;StockMovement (livro-razão)&lt;br&gt;Saldo ≥ 0, estoque mínimo" vertex="1">
                    <mxGeometry height="170" width="360" x="1380" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="c7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BA68C8;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Notificações&lt;/b&gt;&lt;br&gt;&lt;i&gt;genérico · sem contexto no MVP&lt;/i&gt;&lt;br&gt;&lt;br&gt;Port EmailSender: link de acesso e orçamento" vertex="1">
                    <mxGeometry height="110" width="360" x="1380" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="c8" edge="1" parent="1" source="c3" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="c5" value="&lt;b&gt;OHS&lt;/b&gt; · U → D&lt;br&gt;JWT + claims">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c9" edge="1" parent="1" source="c3" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="c4" value="&lt;b&gt;OHS&lt;/b&gt; · U → D&lt;br&gt;Customer.userId (login opcional)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c10" edge="1" parent="1" source="c4" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="c5" value="&lt;b&gt;Cliente/Fornecedor&lt;/b&gt; · U → D&lt;br&gt;customerId, vehicleId">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c11" edge="1" parent="1" source="c6" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="c5" value="&lt;b&gt;Cliente/Fornecedor + Conformista&lt;/b&gt; · U → D&lt;br&gt;serviceId, productId, preço (snapshot)&amp;nbsp;&lt;span style=&quot;color: rgb(95, 107, 122);&quot;&gt;porta de saída (e-mail)&lt;/span&gt;">
                    <mxGeometry relative="1" x="-0.0811" y="-25" as="geometry">
                        <mxPoint as="offset"/>
                        <Array as="points">
                            <mxPoint x="1370" y="425"/>
                            <mxPoint x="1370" y="425"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c12" edge="1" parent="1" source="c5" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" target="c7" value="orçamento por e-mail">
                    <mxGeometry relative="1" x="-0.2601" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c13" edge="1" parent="1" source="c3" style="html=1;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#5F6B7A;labelBackgroundColor=#FAFAF7;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" target="c7" value="link de acesso por e-mail">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;verticalAlign=top;align=left;spacing=12;fontSize=13;shadow=1;fontFamily=Helvetica;fontColor=#1F2933;" value="&lt;b style=&#39;font-size:14px&#39;&gt;Shared Kernel&lt;/b&gt; · &lt;i&gt;src/shared/domain&lt;/i&gt;&lt;br&gt;Email (VO), DomainError, IdGenerator (UUID v7): compartilhados por todos os contextos" vertex="1">
                    <mxGeometry height="90" width="420" x="590" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="c15" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#1F2933;" value="• &lt;b&gt;OHS (Open Host Service):&lt;/b&gt; Identidade expõe um contrato estável (token + claims) que os outros contextos só consomem, sem conhecer como a autenticação funciona.&lt;br&gt;• &lt;b&gt;Cliente/Fornecedor:&lt;/b&gt; Atendimento depende dos dados de Clientes e do Catálogo; os upstreams evoluem considerando essa necessidade.&lt;br&gt;• &lt;b&gt;Conformista:&lt;/b&gt; Atendimento usa o modelo do Catálogo como está (preço e item) e congela uma cópia na OS.&lt;br&gt;• &lt;b&gt;Sem ACL:&lt;/b&gt; todos os contextos estão no mesmo monolito, com a mesma linguagem ubíqua e contratos internos por port; uma camada anticorrupção só faria sentido com um sistema externo ou legado.&lt;br&gt;• Relações sempre &lt;b&gt;por ID&lt;/b&gt;: nenhum agregado navega para dentro de outro contexto." vertex="1">
                    <mxGeometry height="190" width="1420" x="40" y="740" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
